#!/usr/bin/env bash
# ws: use Finlit Workspace from a terminal or a Claude Code session.
#
#   ws list                    open tasks (needs changes, to do, in progress)
#   ws show 12 [15 ...]        everything about the task(s): description, checklist, links, updates, attachment links
#   ws files 12                download the task's screenshots / voice notes / files into ./ws-files/12/ (prints the paths)
#   ws start 12                move the task to "In progress"
#   ws note 12 "text"          post an update on the task
#   ws tick 12 "part of text"  tick the checklist point that contains that text
#   ws done 12 "what changed"  post a summary and mark the task Done (the team then verifies it)
#
# Settings (environment variables):
#   WS_URL     default https://workspace.finlitventures.com
#   WS_MEMBER  name the updates are posted under (default "Claude"; created on first use)
#   WS_TOKEN   the API key. Not needed in Claude Code cloud sessions where the key is saved as a
#              network secret for the host: the proxy adds it to every request by itself.
set -euo pipefail
shopt -s inherit_errexit 2>/dev/null || true

WS_URL="${WS_URL:-https://workspace.finlitventures.com}"
WS_URL="${WS_URL%/}"
WS_MEMBER="${WS_MEMBER:-Claude}"
AUTH=()
[ -n "${WS_TOKEN:-}" ] && AUTH=(-H "Authorization: Bearer $WS_TOKEN")

die() { echo "ws: $*" >&2; exit 1; }

# request: prints the body, exits with the server's error message on HTTP errors
req() {
  local out code
  out="$(curl -sS ${AUTH[@]+"${AUTH[@]}"} -w $'\n%{http_code}' "$@")" || die "could not reach $WS_URL (is the host allowed and the key saved?)"
  code="${out##*$'\n'}"; out="${out%$'\n'*}"
  if [ "$code" = 401 ]; then die "401: the API key is missing or wrong (save it as a network secret for ${WS_URL#https://}, or set WS_TOKEN)"; fi
  if [ "$code" -ge 400 ]; then die "HTTP $code: $out"; fi
  printf '%s' "$out"
}
json() { python3 -c "$1" "${@:2}"; }

member_id() {
  local id
  local list; list="$(req "$WS_URL/api/members")"
  id="$(printf '%s' "$list" | json 'import sys,json
n=sys.argv[1].lower()
m=[x for x in json.load(sys.stdin) if x["name"].lower()==n and x["active"]]
print(m[0]["id"] if m else "")' "$WS_MEMBER")"
  if [ -z "$id" ]; then
    id="$(req -H 'content-type: application/json' -d "$(json 'import sys,json; print(json.dumps({"name": sys.argv[1]}))' "$WS_MEMBER")" "$WS_URL/api/members" \
      | json 'import sys,json; print(json.load(sys.stdin)["id"])')"
  fi
  printf '%s' "$id"
}
post() {  # post PATH JSON
  req -H 'content-type: application/json' -H "x-member-id: $(member_id)" -d "$2" "$WS_URL$1" >/dev/null
}
task_json() { local out; out="$(req "$WS_URL/api/tasks/$1")"; printf '%s' "$out"; }
need_id() { [[ "${1:-}" =~ ^#?[0-9]+$ ]] || die "give a task number, e.g. ws $CMD 12"; printf '%s' "${1#\#}"; }

CMD="${1:-help}"; shift || true
case "$CMD" in
  list)
    data="$(req "$WS_URL/api/tasks")"
    printf '%s' "$data" | json 'import sys,json
order={"reopened":0,"todo":1,"in_progress":2}
label={"reopened":"NEEDS CHANGES","todo":"to do","in_progress":"in progress"}
ts=[t for t in json.load(sys.stdin)["tasks"] if t["status"] in order]
ts.sort(key=lambda t:(order[t["status"]],t["id"]))
for t in ts:
    extra=(" · due "+t["due_date"]) if t.get("due_date") else ""
    print("#%-4s %-14s %-7s %s%s" % (t["id"], label[t["status"]], t["priority"], t["title"], extra))
print(f"\n{len(ts)} open task(s)")'
    ;;
  show)
    [ $# -ge 1 ] || die "usage: ws show 12 [15 ...]"
    ids="$(printf '%s,' "${@#\#}")"; req "$WS_URL/api/export.md?ids=${ids%,}"; echo
    ;;
  files)
    id="$(need_id "${1:-}")"; dir="ws-files/$id"; mkdir -p "$dir"
    data="$(task_json "$id")"
    printf '%s' "$data" | json 'import sys,json
for a in json.load(sys.stdin)["attachments"]:
    print(a["url"] + "\t" + str(a["id"]) + "-" + "".join(c if c.isalnum() or c in "._-" else "_" for c in a["name"]))' |
    while IFS=$'\t' read -r url name; do
      curl -fsS ${AUTH[@]+"${AUTH[@]}"} -o "$dir/$name" "$WS_URL$url" && echo "$dir/$name"
    done
    ;;
  start)
    id="$(need_id "${1:-}")"
    data="$(task_json "$id")"
    st="$(printf '%s' "$data" | json 'import sys,json; print(json.load(sys.stdin)["status"])')"
    case "$st" in
      in_progress) echo "#$id is already in progress" ;;
      todo|reopened) post "/api/tasks/$id/status" '{"status":"in_progress"}'; echo "#$id → in progress" ;;
      *) die "#$id is '$st'; only to-do / needs-changes tasks can be started" ;;
    esac
    ;;
  note)
    id="$(need_id "${1:-}")"; shift; [ $# -ge 1 ] || die 'usage: ws note 12 "text"'
    post "/api/tasks/$id/updates" "$(json 'import sys,json; print(json.dumps({"body": sys.argv[1]}))' "$*")"; echo "update posted on #$id"
    ;;
  tick)
    id="$(need_id "${1:-}")"; shift; [ $# -ge 1 ] || die 'usage: ws tick 12 "part of the point text"'
    data="$(task_json "$id")"
    item="$(printf '%s' "$data" | json 'import sys,json
q=sys.argv[1].lower()
m=[c for c in json.load(sys.stdin)["checklist"] if q in c["text"].lower()]
print(("" if m[0]["done"] else m[0]["id"]) if len(m)==1 else ("?" if not m else "!"))' "$*")"
    case "$item" in
      "") echo "already ticked" ;;
      "?") die "no checklist point on #$id contains: $*" ;;
      "!") die "more than one point on #$id matches; use more of the text" ;;
      *) post "/api/tasks/$id/checklist" "{\"op\":\"toggle\",\"item\":\"$item\"}"; echo "ticked on #$id" ;;
    esac
    ;;
  done)
    id="$(need_id "${1:-}")"; shift; [ $# -ge 1 ] || die 'usage: ws done 12 "what was changed"'
    post "/api/tasks/$id/updates" "$(json 'import sys,json; print(json.dumps({"body": sys.argv[1]}))' "$*")"
    data="$(task_json "$id")"
    st="$(printf '%s' "$data" | json 'import sys,json; print(json.load(sys.stdin)["status"])')"
    [ "$st" = done ] || post "/api/tasks/$id/status" '{"status":"done"}'
    echo "#$id → done (waiting for the team to verify)"
    ;;
  *)
    sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'
    ;;
esac
