# Copy to .env (or set these in your hosting dashboard). Everything is optional.

# Name shown in the app header
APP_NAME=Finlit Workspace

# Port the server listens on
PORT=3000

# Shared passcode the whole team types once per device. Leave empty = no passcode (only OK on a private network).
TEAM_PASSCODE=

# Where the database and uploaded files are stored. Put this on a persistent disk / volume when hosting.
DATA_DIR=./data

# Max size per uploaded file (screenshots, videos, voice notes)
MAX_UPLOAD_MB=25

# ---- Voice → text with Whisper (optional) ----
# Without a key, the browser's built-in speech recognition is used (works in Chrome / Edge / Android / Safari).
# With a key, recordings are transcribed by Whisper on the server: better accuracy for Hinglish and accents,
# and "Hindi → English text" translation works.
#
# OpenAI:
# WHISPER_API_KEY=sk-...
# WHISPER_MODEL=whisper-1
#
# Groq (OpenAI-compatible, fast and cheap):
# WHISPER_BASE_URL=https://api.groq.com/openai/v1
# WHISPER_API_KEY=gsk_...
# WHISPER_MODEL=whisper-large-v3
#
# Self-hosted (any OpenAI-compatible speech-to-text server, e.g. faster-whisper based):
# WHISPER_BASE_URL=http://localhost:8000/v1
# WHISPER_API_KEY=anything
# WHISPER_MODEL=Systran/faster-whisper-small

# ---- Cloud storage (optional) ----
# Any S3-compatible bucket: AWS S3, Cloudflare R2, Supabase Storage, Backblaze B2…
# Uploaded files and the database are also kept in the bucket, so nothing is lost if the server's disk is.
# Needed on hosts WITHOUT a permanent disk (the database is restored from the bucket on start).
# AWS S3 example:
# S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
# S3_REGION=ap-south-1
# S3_BUCKET=finlit-workspace
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=workspace/
